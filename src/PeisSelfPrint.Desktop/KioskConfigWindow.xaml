<Window x:Class="PeisSelfPrint.Desktop.KioskConfigWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="运维配置" Width="940" Height="720" WindowStartupLocation="CenterScreen" Topmost="True"
 Background="#F3F7FA" FontFamily="Microsoft YaHei UI" Foreground="#183445" ShowInTaskbar="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="42"/><Setter Property="MinWidth" Value="96"/><Setter Property="Padding" Value="16,8"/>
   <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#087E8B"/>
   <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonFace" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFace" Property="Background" Value="#DFE7EC"/><Setter Property="Foreground" Value="#728894"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#22606D"/><Setter Property="BorderBrush" Value="#C7DCE2"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Group" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20,14"/><Setter Property="BorderBrush" Value="#E1EAF0"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid Margin="18,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel Orientation="Horizontal"><TextBlock Text="运维配置" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="SettingsPathText" FontSize="13" Foreground="#7B8F99" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
   <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" MinWidth="110"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Group}" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="打印机配置" FontSize="21" FontWeight="Bold" Margin="0,0,0,10"/>
      <TextBlock Text="输出打印机" FontSize="15" Foreground="#5C7785"/>
      <ComboBox x:Name="PrinterCombo" FontSize="16" Height="40" Margin="0,4,0,8" SelectionChanged="Printer_SelectionChanged"/>
      <TextBlock x:Name="DefaultPrinterText" FontSize="14" Foreground="#607A87" Margin="0,0,0,10"/>
      <WrapPanel>
       <Button Content="保存打印机设置" Click="SavePrinter_Click" MinWidth="150"/>
       <Button Content="设为系统默认" Click="SetDefaultPrinter_Click" Style="{StaticResource SecondaryButton}" MinWidth="130"/>
       <Button Content="打印测试页" Click="PrintTest_Click" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0"/>
      </WrapPanel>
      <TextBlock x:Name="PrinterHint" FontSize="14" Foreground="#986510" Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Group}" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="运行方式" FontSize="21" FontWeight="Bold" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <TextBlock Text="服务模式" FontSize="15" Foreground="#5C7785" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ComboBox x:Name="ModeCombo" FontSize="16" Height="40" Width="200">
        <ComboBoxItem Content="正式服务 (Live)" Tag="Live"/>
        <ComboBoxItem Content="演示模式 (Demo)" Tag="Demo"/>
       </ComboBox>
      </StackPanel>
      <CheckBox x:Name="PhysicalPrintingCheck" Content="启用真实出纸（不勾选则模拟打印）" FontSize="16" Margin="0,0,0,6"/>
      <CheckBox x:Name="FullScreenCheck" Content="全屏运行" FontSize="16" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
       <TextBlock Text="医院名称" FontSize="15" Foreground="#5C7785" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBox x:Name="HospitalBox" FontSize="16" Height="36" Width="240" Padding="8,4"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Group}">
     <StackPanel>
      <TextBlock Text="应用" FontSize="21" FontWeight="Bold" Margin="0,0,0,10"/>
      <WrapPanel>
       <Button Content="保存全部设置" Click="SaveAll_Click" MinWidth="150"/>
       <Button Content="保存并重启程序" Click="SaveRestart_Click" MinWidth="160" Margin="0"/>
       <Button Content="打开打印引擎目录" Click="OpenTools_Click" Style="{StaticResource SecondaryButton}" MinWidth="160" Margin="0"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Column="1" Style="{StaticResource Group}" Margin="12,0,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="环境检测" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="一键检测" Click="RunChecks_Click" MinWidth="110" Margin="16,0,0,0"/>
     </StackPanel>
     <ListBox x:Name="CheckList" Grid.Row="1" FontSize="15" BorderThickness="0" Background="#F8FBFC" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
     <Button Grid.Row="2" Content="检测并自动修复引擎路径" Click="CheckFix_Click" Style="{StaticResource SecondaryButton}" MinWidth="190" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="入口：主界面右上角时间处连续点击 5 次（间隔不超过 2 秒）。" FontSize="13" Foreground="#7B8F99" Margin="0,10,0,0"/>
 </Grid>
</Window>
