<Window x:Class="PeisSelfPrint.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="体检报告自助服务" Width="1366" Height="900" MinWidth="1000" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#F3F7FA" FontFamily="Microsoft YaHei UI" Foreground="#183445"
 PreviewKeyDown="Window_KeyDown" PreviewMouseDown="UserActivity" PreviewTouchDown="UserActivity">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="56"/><Setter Property="MinWidth" Value="100"/><Setter Property="Padding" Value="24,12"/>
   <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#087E8B"/>
   <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,12,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFace" Property="Background" Value="#DFE7EC"/><Setter Property="Foreground" Value="#728894"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFace" Property="BorderThickness" Value="3"/><Setter TargetName="ButtonFace" Property="BorderBrush" Value="#00B4C4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#22606D"/><Setter Property="BorderBrush" Value="#C7DCE2"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="32"/><Setter Property="BorderBrush" Value="#E1EAF0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Background="#F3F7FA">
  <Grid x:Name="ShellGrid" Margin="32,22">
   <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="76"/><RowDefinition x:Name="StepsRow" Height="68"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="78"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="HospitalLabel" Text="体检中心" FontSize="18" Foreground="#5A7785"/><TextBlock Text="报告自助服务" FontSize="30" FontWeight="Bold"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border x:Name="ModeBadge" Background="#FFF3DB" CornerRadius="10" Padding="14,8" Margin="0,0,16,0"><TextBlock x:Name="ModeText" Text="演示模式 · 不会出纸" FontSize="17" Foreground="#986510"/></Border>
     <TextBlock x:Name="ClockText" FontSize="18" VerticalAlignment="Center" Foreground="#607A87"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Step1" Text="① 扫码查询" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="Step2" Grid.Column="1" Text="② 选择报告" FontSize="21" VerticalAlignment="Center"/>
    <TextBlock x:Name="Step3" Grid.Column="2" Text="③ 核对打印" FontSize="21" VerticalAlignment="Center"/>
    <TextBlock x:Name="Step4" Grid.Column="3" Text="④ 领取报告" FontSize="21" VerticalAlignment="Center"/>
   </Grid>
   <Grid Grid.Row="2">
    <Grid x:Name="WelcomePanel"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="WelcomeCard" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="WelcomeInputScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"><StackPanel>
      <TextBlock x:Name="WelcomeTitle" Text="请扫描体检单上的条码" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock x:Name="WelcomeSubtitle" Text="将条码对准扫描口，或在下方输入体检号" FontSize="19" Foreground="#5C7785" Margin="0,0,0,24"/>
      <TextBlock x:Name="InputLabel" Text="体检号" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="ExamInput" FontSize="29" Height="64" MaxLength="64" Padding="14,10" VerticalContentAlignment="Center" BorderBrush="#8DBBC6" BorderThickness="2" AutomationProperties.Name="体检号输入框" TextChanged="ExamInput_Changed"/>
      <TextBlock x:Name="InputHint" Text="请保留体检号中的前导零，扫码后按回车即可查询" FontSize="16" Foreground="#617C89" Margin="0,10,0,16"/>
      <UniformGrid x:Name="NumberKeys" Columns="5" Margin="0,0,0,12"/>
      <UniformGrid x:Name="LetterKeys" Columns="7" Visibility="Collapsed" Margin="0,0,0,12"/>
      <StackPanel x:Name="InputActions" Orientation="Horizontal" Margin="0,0,0,18"><Button Content="字母键盘" Click="ToggleLetters" Style="{StaticResource SecondaryButton}" MinWidth="140"/><Button Content="退格" Click="Backspace" Style="{StaticResource SecondaryButton}"/><Button Content="清空" Click="ClearInput" Style="{StaticResource SecondaryButton}"/></StackPanel>
     </StackPanel></ScrollViewer>
      <Button x:Name="LookupButton" Grid.Row="1" Content="查询我的报告  →" Click="Lookup_Click" FontSize="24" MinHeight="68" HorizontalAlignment="Stretch" Margin="0"/>
     </Grid></Border>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Style="{StaticResource Card}" Background="#E8F5F5" Margin="0,0,0,18"><StackPanel><TextBlock Text="领取报告，只需三步" FontSize="25" FontWeight="Bold" Margin="0,0,0,24"/><TextBlock Text="1  扫描体检条码，查询报告" FontSize="21" Margin="0,0,0,20"/><TextBlock Text="2  选择需要领取的已完成报告" FontSize="21" Margin="0,0,0,20"/><TextBlock Text="3  核对信息，等待打印并取走" FontSize="21"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="26"><StackPanel><TextBlock Text="温馨提示" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="正在审核的报告暂不可领取。离开前请点击“结束本次服务”，设备也会在闲置后自动清屏。" FontSize="19" Foreground="#5C7785"/></StackPanel></Border>
      <Border x:Name="DemoScenarios" Background="#FFF4DF" CornerRadius="16" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock Text="演示体验 · 以下均为模拟数据" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button Content="正常报告" Tag="DEMO001" Click="Demo_Click" FontSize="16" Padding="12,6" MinHeight="42" Margin="0,0,8,8"/><Button Content="审核中" Tag="DEMO002" Click="Demo_Click" FontSize="16" Padding="12,6" MinHeight="42" Margin="0,0,8,8"/><Button Content="无记录" Tag="DEMO003" Click="Demo_Click" FontSize="16" Padding="12,6" MinHeight="42" Margin="0,0,8,8"/><Button Content="缺纸" Tag="DEMO004" Click="Demo_Click" FontSize="16" Padding="12,6" MinHeight="42" Margin="0,0,8,8"/><Button Content="网络故障" Tag="DEMO005" Click="Demo_Click" FontSize="16" Padding="12,6" MinHeight="42" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border x:Name="LoadingPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720"><TextBlock Text="正在查询您的报告" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="请稍候，无需重复扫码或点击" FontSize="23" Foreground="#5C7785" Margin="0,18,0,32" HorizontalAlignment="Center"/><ProgressBar IsIndeterminate="True" Height="12" Width="520" Foreground="#087E8B"/><Button Content="取消查询" Style="{StaticResource SecondaryButton}" Click="Home_Click" HorizontalAlignment="Center" Margin="0,36,0,0"/></StackPanel></Border>
    <Border x:Name="ReportsPanel" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="请选择需要领取的报告" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="PersonSummary" FontSize="20" Foreground="#5C7785" Margin="0,10,0,16"/><TextBlock x:Name="ReportNotice" FontSize="18" Foreground="#986510" Margin="0,0,0,16"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReportsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F5F9FB" BorderBrush="#DDE8EE" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanPrint}" VerticalAlignment="Center" HorizontalAlignment="Left" Checked="Selection_Changed" Unchecked="Selection_Changed" AutomationProperties.Name="选择报告"><CheckBox.LayoutTransform><ScaleTransform ScaleX="1.9" ScaleY="1.9"/></CheckBox.LayoutTransform></CheckBox><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="18" Foreground="#607A87" Margin="0,8,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="19" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="选择全部可领取报告" Click="SelectAll_Click" Style="{StaticResource SecondaryButton}" FontSize="18"/><TextBlock x:Name="SelectionText" FontSize="20" VerticalAlignment="Center"/></StackPanel><Button x:Name="ContinueButton" Grid.Column="1" Content="下一步：核对报告  →" Click="Confirm_Click" Margin="0"/></Grid>
    </Grid></Border>
    <Border x:Name="ConfirmPanel" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="打印前，请核对以下信息" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="ConfirmIdentity" FontSize="22" Margin="0,14,0,20"/></StackPanel>
     <ScrollViewer Grid.Row="1"><StackPanel><Border Background="#F3F8FA" CornerRadius="14" Padding="24"><TextBlock x:Name="ConfirmReports" FontSize="23" LineHeight="42"/></Border>
      <TextBlock x:Name="PrinterStatus" FontSize="20" Margin="0,20,0,12"/><CheckBox x:Name="Acknowledge" Content="我已核对体检号和所选报告" FontSize="23" IsChecked="True" IsEnabled="False" Margin="0,10,0,16" Padding="10"/><TextBlock x:Name="ConfirmHint" FontSize="18" Foreground="#986510"/></StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="返回选择" Style="{StaticResource SecondaryButton}" Click="BackToReports"/><Button x:Name="PrintButton" Content="确认打印" Click="Print_Click" IsEnabled="False" Margin="0" FontSize="24" MinHeight="66"/></StackPanel>
    </Grid></Border>
    <Border x:Name="PrintingPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="850"><TextBlock x:Name="PrintingTitle" Text="正在准备报告" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PrintingDetail" FontSize="24" Foreground="#54717F" HorizontalAlignment="Center" Margin="0,22,0,24"/><ProgressBar x:Name="PrintProgressBar" Width="620" Height="18" Minimum="0" Maximum="100" Foreground="#087E8B"/><TextBlock Text="请勿重复操作，请在处理结束后取走报告" FontSize="21" HorizontalAlignment="Center" Margin="0,28,0,0"/></StackPanel></Border>
    <Border x:Name="ResultPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="820"><Border Background="#E1F4ED" CornerRadius="48" Width="96" Height="96" HorizontalAlignment="Center"><TextBlock Text="✓" FontSize="56" Foreground="#168365" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="ResultTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,12"/><TextBlock x:Name="ResultMessage" FontSize="24" TextAlignment="Center" LineHeight="38" Margin="0,0,0,28"/><Button Content="结束本次服务" Click="Home_Click" HorizontalAlignment="Center" MinWidth="300" MinHeight="66"/><TextBlock x:Name="ResultCountdown" FontSize="18" Foreground="#6B838D" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Border>
    <Border x:Name="ErrorPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="880"><TextBlock x:Name="ErrorTitle" Text="暂时无法完成查询" FontSize="34" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="ErrorMessage" FontSize="24" Foreground="#5A7180" TextAlignment="Center" LineHeight="40" Margin="0,22,0,16"/><TextBlock x:Name="ErrorCodeText" FontSize="16" Foreground="#7B8F99" TextAlignment="Center" Margin="0,0,0,28"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="RetryButton" Content="重新查询" Click="Lookup_Click"/><Button Content="重新输入" Click="Home_Click" Style="{StaticResource SecondaryButton}"/><Button Content="寻求帮助" Click="Help_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></StackPanel></Border>
   </Grid>
   <Grid x:Name="FooterGrid" Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ServiceStatus" Text="● 设备就绪" FontSize="18" Foreground="#168365"/><TextBlock x:Name="PrivacyText" Text="　·　闲置后自动清除本次信息" FontSize="17" Foreground="#6B838D"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="HomeButton" Content="结束本次服务" Click="Home_Click" Style="{StaticResource SecondaryButton}" FontSize="18"/><Button Content="需要帮助" Click="Help_Click" Style="{StaticResource SecondaryButton}" FontSize="18" Margin="0"/></StackPanel></Grid>
  </Grid>
  <Grid x:Name="IdleOverlay" Background="#A6183445" Visibility="Collapsed"><Border Background="White" CornerRadius="24" Padding="40" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="您还在使用吗？" FontSize="32" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="IdleMessage" FontSize="23" TextAlignment="Center" Margin="0,18,0,28"/><Button Content="继续使用" Click="ContinueSession_Click" Margin="0,0,0,14"/><Button Content="结束并清除信息" Click="Home_Click" Style="{StaticResource SecondaryButton}" Margin="0"/></StackPanel></Border></Grid>
  <Grid x:Name="HelpOverlay" Background="#A6183445" Visibility="Collapsed"><Border Background="White" CornerRadius="24" Padding="40" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="我们来帮您" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="SupportLabel" FontSize="24" LineHeight="40" Margin="0,20,0,16"/><TextBlock Text="报告尚未完成、信息不符或未取到纸质报告时，请由工作人员协助处理。请勿反复打印。" FontSize="20" Foreground="#5A7180" Margin="0,0,0,26"/><Button Content="返回继续" Click="CloseHelp_Click" Margin="0"/></StackPanel></Border></Grid>
 </Grid>
</Window>
